{
  "name": "medora-medical-supply-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:web": "npm run dev --workspace frontend",
    "dev:api": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "seed": "npm run seed --workspace backend",
    "db:sync": "npm run db:sync --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
